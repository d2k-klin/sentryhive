<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SentryHive Security Report — {{ r.client_name or r.account_id or "scan" }}</title>
<style>
  :root {
    --paper:#f4f1ea; --surface:#fffdfa; --ink:#1f2529; --muted:#667078;
    --line:#d8d3c8; --accent:#b45309; --accent-soft:#fff3df; --good:#24754a;
  }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; }
  body {
    margin:0; color:var(--ink); background:var(--paper);
    font:14px/1.55 Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  }
  code {
    color:inherit; background:#efebe3; border-radius:3px; padding:1px 4px;
    font:12px/1.45 ui-monospace,SFMono-Regular,Menlo,monospace;
    overflow-wrap:anywhere; word-break:break-word;
  }
  a { color:#95500a; }
  header {
    color:#fff; background:#20282d; border-bottom:4px solid var(--accent);
    padding:34px max(28px,calc((100vw - 1160px)/2));
  }
  .brand { display:flex; align-items:center; gap:18px; }
  .brand img { max-height:52px; max-width:180px; background:#fff; padding:5px; }
  .eyebrow { color:#f7c47e; font-size:11px; font-weight:750; letter-spacing:.15em; text-transform:uppercase; }
  h1 { margin:2px 0 0; font-family:Georgia,"Times New Roman",serif; font-size:31px; line-height:1.15; }
  h2 { margin:0 0 14px; font-family:Georgia,"Times New Roman",serif; font-size:21px; line-height:1.25; }
  h3 { margin:0 0 6px; font-size:14px; }
  .meta { display:flex; flex-wrap:wrap; gap:8px 20px; margin-top:16px; color:#cbd1d5; font-size:12px; }
  .meta code { color:#fff; background:#303b42; }
  main { max-width:1160px; margin:0 auto; padding:28px; }
  section {
    margin:0 0 18px; padding:20px 22px; background:var(--surface);
    border:1px solid var(--line); border-radius:6px;
  }
  .lede { max-width:850px; color:#4f5960; font-size:15px; }
  .metrics {
    display:grid; grid-template-columns:repeat(7,minmax(92px,1fr));
    border:1px solid var(--line); border-radius:6px; overflow:hidden; margin-bottom:18px;
  }
  .metric { min-height:88px; padding:14px 16px; background:var(--surface); border-right:1px solid var(--line); }
  .metric:last-child { border:0; }
  .metric strong { display:block; font-family:Georgia,"Times New Roman",serif; font-size:28px; line-height:1.2; }
  .metric span { color:var(--muted); font-size:10px; font-weight:750; letter-spacing:.08em; text-transform:uppercase; }
  .alert { border-left:5px solid #c2410c; background:#fff7ed; }
  .note { border-left:5px solid #3f697d; background:#f1f7f8; }
  .section-note { color:var(--muted); margin:-8px 0 14px; }
  table { width:100%; border-collapse:collapse; table-layout:fixed; }
  th,td { padding:9px 8px; border-bottom:1px solid var(--line); text-align:left; vertical-align:top; overflow-wrap:anywhere; }
  th { color:var(--muted); font-size:10px; letter-spacing:.08em; text-transform:uppercase; }
  tr:last-child td { border-bottom:0; }
  .sev {
    display:inline-block; min-width:58px; padding:2px 7px; border-radius:3px;
    color:#fff; font-size:10px; font-weight:800; letter-spacing:.04em; text-align:center; text-transform:uppercase;
  }
  .tag {
    display:inline-block; margin:2px 2px 0 0; padding:1px 6px; color:#5d666c;
    border:1px solid #cbc6bb; border-radius:999px; font-size:10px; line-height:1.55;
  }
  .status-fail { color:#a42b1e; border-color:#d9a59d; }
  .status-pass { color:var(--good); border-color:#9fcab2; }
  .status-info { color:#386779; border-color:#a5c3ce; }
  .plain { white-space:pre-line; }
  .remediation { color:#236642; }
  .risk-list { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
  .risk {
    padding:14px; border:1px solid var(--line); border-left:4px solid var(--accent); background:#fff;
    min-width:0; overflow-wrap:anywhere; break-inside:avoid;
  }
  .risk-head { display:flex; align-items:flex-start; gap:8px; margin-bottom:6px; }
  .risk p { margin:6px 0 0; color:#4f5960; }
  .controls {
    position:sticky; top:0; z-index:2; display:grid; grid-template-columns:2fr repeat(3,1fr) auto;
    gap:8px; margin:0 -6px 14px; padding:10px 6px; background:rgba(255,253,250,.96);
    border-bottom:1px solid var(--line); backdrop-filter:blur(8px);
  }
  .controls input,.controls select {
    min-width:0; padding:8px 9px; color:var(--ink); background:#fff;
    border:1px solid #bdb7aa; border-radius:4px; font:inherit;
  }
  .visible-count { align-self:center; color:var(--muted); font-size:12px; white-space:nowrap; }
  details { margin-top:5px; }
  summary { color:#7b470f; cursor:pointer; user-select:none; }
  details p { margin:7px 0; }
  .bar { display:flex; align-items:center; gap:8px; }
  .track { width:100%; height:7px; overflow:hidden; background:#e8e3da; border-radius:99px; }
  .track span { display:block; height:100%; background:var(--good); }
  footer { padding:16px 28px 32px; color:var(--muted); text-align:center; font-size:11px; }
  .empty { padding:22px; color:var(--muted); text-align:center; }
  @media (max-width:850px) {
    .metrics { grid-template-columns:repeat(2,1fr); }
    .metric { border-bottom:1px solid var(--line); }
    .risk-list { grid-template-columns:1fr; }
    .controls { grid-template-columns:1fr 1fr; position:static; }
    .wide-table { display:block; overflow-x:auto; }
    main { padding:18px 12px; }
    header { padding:26px 18px; }
  }
  @media screen { .print-only { display:none !important; } }
  @media print {
    @page {
      size:A4; margin:16mm 14mm 18mm;
      @bottom-center {
        content:"OSS SentryHive by Mr. D — Confidential{% if r.client_name %} — {{ r.client_name }}{% endif %} — " counter(page) " / " counter(pages);
        color:#70777b; font-size:8.5px;
      }
    }
    @page:first { @bottom-center { content:none; } }
    :root { --paper:#fff; --surface:#fff; --line:#cfd2d3; }
    body { background:#fff; font-size:10px; line-height:1.38; }
    .screen-only { display:none !important; }
    .print-only { display:block; }
    header { padding:12mm 0 6mm; color:#1f2529; background:#fff; border-bottom:2px solid #1f2529; }
    header .meta { color:#596168; }
    header .meta code { color:#1f2529; background:#f0f0ed; }
    h1 { font-size:23px; }
    h2 { font-size:16px; margin-bottom:8px; }
    main { max-width:none; padding:8mm 0 0; }
    section { padding:10px 12px; margin-bottom:8px; border-radius:0; }
    section.keep,.risk { break-inside:avoid; }
    .metrics { grid-template-columns:repeat(7,1fr); margin-bottom:8px; }
    .metric { min-height:55px; padding:7px; }
    .metric strong { font-size:19px; }
    .metric span { font-size:7px; }
    th,td { padding:5px 5px; font-size:8.5px; }
    th { font-size:7px; }
    code { font-size:8px; padding:0 2px; background:#f1f1ee; }
    .sev { min-width:42px; padding:1px 4px; font-size:7px; }
    .tag { font-size:7px; }
    .risk-list { grid-template-columns:repeat(2,minmax(0,1fr)); gap:5px; }
    .risk { padding:7px; }
    .risk p { margin:3px 0 0; }
    footer { display:none; }
    .cover {
      height:250mm; padding-top:48mm; text-align:center; page-break-after:always;
    }
    .cover img { max-height:22mm; max-width:65mm; margin-bottom:12mm; }
    .cover .mark { color:var(--accent); font-size:18px; }
    .cover .title { margin:3mm 0; font:700 28px/1.2 Georgia,serif; }
    .cover .client-name { margin:5mm 0 18mm; color:var(--accent); font-size:17px; font-weight:700; }
    .confidential {
      display:inline-block; padding:2mm 6mm; color:#a42b1e; border:1.5px solid #a42b1e;
      font-size:10px; font-weight:800; letter-spacing:.15em;
    }
    .cover-meta { margin-top:20mm; color:#596168; line-height:1.8; }
    .scope { page-break-after:always; }
    .scope .section-note { margin:4mm 0 0; }
    .toc { page-break-after:always; }
    .toc ul { padding:0; list-style:none; }
    .toc a { color:#1f2529; text-decoration:none; }
    .toc a::after { content:leader(".") target-counter(attr(href),page); }
    .register { table-layout:fixed; }
    .register col:nth-child(1) { width:11%; }
    .register col:nth-child(2) { width:12%; }
    .register col:nth-child(3) { width:29%; }
    .register col:nth-child(4) { width:48%; }
    .register tr { break-inside:avoid; }
  }
</style>
</head>
<body>
<div class="print-only cover">
  {% if r.logo_data_uri %}<img src="{{ r.logo_data_uri }}" alt="Client logo">{% endif %}
  <div class="mark">⬡</div>
  <div class="title">SentryHive Security Assessment</div>
  {% if r.client_name %}<div class="client-name">{{ r.client_name }}</div>{% endif %}
  <div class="confidential">CONFIDENTIAL</div>
  <div class="cover-meta">
    {% if r.is_rollup %}Accounts: {{ r.accounts | join(", ") }}{% else %}Account: {{ r.account_id or "n/a" }}{% endif %}<br>
    Generated: {{ r.generated_at }}<br>
    Generated by OSS SentryHive v{{ r.tool_version }}<br>
    Created by Mr. D
  </div>
</div>

<section class="print-only scope">
  <h2>Scope &amp; methodology</h2>
  <table>
    <tbody>
      {% if r.is_rollup %}
      <tr><th>Accounts</th><td>{{ r.accounts | join(", ") or "n/a" }}</td></tr>
      {% else %}
      <tr><th>Account</th><td>{{ r.account_id or "n/a" }}</td></tr>
      <tr><th>Verified identity</th><td><code>{{ r.identity_arn or "n/a" }}</code></td></tr>
      {% endif %}
      <tr><th>Regions</th><td>{{ r.regions | join(", ") or "n/a" }}</td></tr>
      <tr><th>Generated</th><td>{{ r.generated_at }}</td></tr>
      <tr><th>Toolchain</th><td>{% for s in r.scanners %}{{ s.name }} {{ s.version or "(version unavailable)" }} — {{ s.status }}{% if not loop.last %}<br>{% endif %}{% endfor %}</td></tr>
      <tr><th>Evidence</th><td>{{ r.failed_total }} failing · {{ r.status_counts.get("pass",0) }} passing · {{ r.status_counts.get("info",0) }} observations</td></tr>
    </tbody>
  </table>
  <p class="section-note">All scanners and report rendering run locally. Public attack-surface observations require human validation and are not counted as failures unless CloudFox emitted an unambiguous risk signal.</p>
</section>

<section class="print-only toc">
  <h2>Contents</h2>
  <ul>
    <li><a href="#summary">Executive summary</a></li>
    <li><a href="#priority">Priority risks</a></li>
    {% if r.compliance %}<li><a href="#compliance">Compliance posture</a></li>{% endif %}
    {% if r.attack_surface_findings %}<li><a href="#attack-surface">AWS attack surface</a></li>{% endif %}
    {% if r.resilience_findings %}<li><a href="#resilience">Backup &amp; recovery</a></li>{% endif %}
    {% if r.eks_findings %}<li><a href="#kubernetes">Kubernetes posture</a></li>{% endif %}
    <li><a href="#scanners">Tool execution evidence</a></li>
    <li><a href="#failure-register">Failure register</a></li>
  </ul>
</section>

<header>
  <div class="brand">
    {% if r.logo_data_uri %}<img src="{{ r.logo_data_uri }}" alt="Client logo">{% endif %}
    <div>
      <div class="eyebrow">{{ r.client_name or "Security assessment" }}</div>
      <h1>⬡ SentryHive Security Report</h1>
    </div>
  </div>
  <div class="meta">
    {% if r.is_rollup %}
    <span>Accounts <code>{{ r.accounts | join(", ") or "n/a" }}</code></span>
    {% else %}
    <span>Account <code>{{ r.account_id or "n/a" }}</code></span>
    <span>Identity <code>{{ r.identity_arn or "n/a" }}</code></span>
    {% endif %}
    <span>Regions <code>{{ r.regions | join(", ") or "n/a" }}</code></span>
    <span>Generated <code>{{ r.generated_at }}</code></span>
    <span>SentryHive <code>v{{ r.tool_version }}</code></span>
  </div>
</header>

<main>
  <div class="metrics" id="summary">
    {% for sev in severity_order %}
    <div class="metric">
      <strong style="color:{{ severity_colors[sev] }}">{{ r.failure_counts.get(sev,0) }}</strong>
      <span>{{ sev }} failures</span>
    </div>
    {% endfor %}
    <div class="metric"><strong>{{ r.status_counts.get("pass",0) }}</strong><span>Pass evidence</span></div>
    <div class="metric"><strong>{{ r.status_counts.get("info",0) }}</strong><span>Observations</span></div>
  </div>

  <section class="keep">
    <h2>Executive summary</h2>
    <p class="lede">
      The assessment produced <strong>{{ r.failed_total }} failing findings</strong> across
      {{ r.services | length }} service area{% if r.services | length != 1 %}s{% endif %}.
      {% if r.failure_counts.get("Critical",0) or r.failure_counts.get("High",0) %}
      Immediate attention is recommended for {{ r.failure_counts.get("Critical",0) }} critical and
      {{ r.failure_counts.get("High",0) }} high-severity failures.
      {% else %}
      No critical or high-severity failures were normalized from the completed scanner output.
      {% endif %}
      {{ r.status_counts.get("pass",0) }} passing checks remain available as evidence; {{ r.status_counts.get("info",0) }}
      informational observations require context-specific validation.
    </p>
  </section>

  {% if r.has_incomplete_scanners %}
  <section class="alert keep">
    <h2>Scan incomplete</h2>
    <p>One or more selected scanners failed or were skipped. Treat absent findings as incomplete evidence, not a clean environment.</p>
    <ul>{% for s in r.incomplete_scanners %}<li><strong>{{ s.name }}</strong> ({{ s.status }}){% if s.message %}: {{ s.message | plain_text }}{% endif %}</li>{% endfor %}</ul>
  </section>
  {% endif %}

  <section id="priority">
    <h2>Priority risks</h2>
    <p class="section-note">Highest-severity failures, ordered for remediation triage.</p>
    {% if r.top_risks %}
    <div class="risk-list">
      {% for f in r.top_risks %}
      <article class="risk">
        <div class="risk-head">
          <span class="sev" style="background:{{ severity_colors[f.severity.label] }}">{{ f.severity.label }}</span>
          <h3>{{ f.title or f.check }}</h3>
        </div>
        <div><span class="tag">{{ f.tool }}</span>{% if f.account_id %}<span class="tag">acct {{ f.account_id }}</span>{% endif %}</div>
        <p><code>{{ f.resource or "n/a" }}</code></p>
        {% if f.description %}<p class="plain">{{ f.description | plain_text }}</p>{% endif %}
        {% if f.remediation %}<p class="remediation plain">Remediation: {{ f.remediation | plain_text }}</p>{% endif %}
      </article>
      {% endfor %}
    </div>
    {% elif r.has_incomplete_scanners %}
    <p class="empty">No priority list is shown because scanner evidence is incomplete.</p>
    {% else %}
    <p class="empty">No failing findings.</p>
    {% endif %}
  </section>

  {% if r.compliance %}
  <section id="compliance">
    <h2>Compliance posture</h2>
    <p class="section-note">Control evidence grouped by mapped framework. This is technical posture, not certification.</p>
    <table>
      <thead><tr><th style="width:32%">Framework</th><th style="width:12%">Pass</th><th style="width:12%">Fail</th><th>Pass rate</th></tr></thead>
      <tbody>
      {% for c in r.compliance %}
      <tr>
        <td><strong>{{ c.framework }}</strong></td><td>{{ c.passed }}</td><td>{{ c.failed }}</td>
        <td><div class="bar"><div class="track"><span style="width:{{ c.pass_pct }}%"></span></div><span>{{ c.pass_pct }}%</span></div></td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}

  {% if r.iam_highlights %}
  <section id="iam">
    <h2>IAM escalation highlights</h2>
    <p class="section-note">Identity paths most likely to increase attacker capability.</p>
    <table>
      <thead><tr><th style="width:12%">Severity</th><th style="width:34%">Resource</th><th>Finding</th></tr></thead>
      <tbody>
      {% for f in r.iam_highlights %}
      <tr><td><span class="sev" style="background:{{ severity_colors[f.severity.label] }}">{{ f.severity.label }}</span></td>
          <td><code>{{ f.resource or "n/a" }}</code></td>
          <td><strong>{{ f.title or f.check }}</strong>{% if f.description %}<br><span class="plain">{{ f.description | plain_text }}</span>{% endif %}</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}

  {% if r.attack_surface_findings %}
  <section id="attack-surface">
    <h2>AWS attack surface</h2>
    <p class="section-note">CloudFox evidence. Informational exposure is not a vulnerability until validated in context.</p>
    <table>
      <thead><tr><th style="width:11%">Status</th><th style="width:13%">Severity</th><th style="width:31%">Resource</th><th>Observation</th></tr></thead>
      <tbody>
      {% for f in r.attack_surface_findings[:50] %}
      <tr><td><span class="tag status-{{ f.status }}">{{ f.status }}</span></td>
          <td><span class="sev" style="background:{{ severity_colors[f.severity.label] }}">{{ f.severity.label }}</span></td>
          <td><code>{{ f.resource or "n/a" }}</code></td><td><strong>{{ f.title or f.check }}</strong></td></tr>
      {% endfor %}
      </tbody>
    </table>
    {% if r.attack_surface_findings | length > 50 %}<p class="section-note">Showing 50 of {{ r.attack_surface_findings | length }}; the full set is in HTML filtering and findings.json.</p>{% endif %}
  </section>
  {% endif %}

  {% if r.resilience_findings %}
  <section id="resilience">
    <h2>Backup &amp; recovery</h2>
    <p class="section-note">Recovery evidence gathered across every scanner. An <span class="tag status-info">info</span> row means the control could not be read — unknown, not passing.</p>
    <table>
      <thead><tr><th style="width:11%">Status</th><th style="width:13%">Severity</th><th style="width:31%">Resource</th><th>Control</th></tr></thead>
      <tbody>
      {% for f in r.resilience_findings[:75] %}
      <tr><td><span class="tag status-{{ f.status }}">{{ f.status }}</span></td>
          <td><span class="sev" style="background:{{ severity_colors[f.severity.label] }}">{{ f.severity.label }}</span></td>
          <td><code>{{ f.resource or "n/a" }}</code></td>
          <td><strong>{{ f.title or f.check }}</strong>{% if f.compliance_refs %}<br><span class="plain">{{ f.compliance_refs | join(", ") | plain_text }}</span>{% endif %}</td></tr>
      {% endfor %}
      </tbody>
    </table>
    {% if r.resilience_findings | length > 75 %}<p class="section-note">Showing 75 of {{ r.resilience_findings | length }}; the full set is in HTML filtering and findings.json.</p>{% endif %}
  </section>
  {% endif %}

  {% if r.eks_findings %}
  <section id="kubernetes">
    <h2>Kubernetes posture</h2>
    <p class="section-note">Combined HardenEKS and Kubescape results for explicitly selected clusters.</p>
    <table>
      <thead><tr><th style="width:12%">Severity</th><th style="width:15%">Tool</th><th style="width:31%">Cluster / resource</th><th>Finding</th></tr></thead>
      <tbody>
      {% for f in r.eks_findings[:75] %}
      <tr><td><span class="sev" style="background:{{ severity_colors[f.severity.label] }}">{{ f.severity.label }}</span></td>
          <td>{{ f.tool }}</td><td><code>{{ f.resource or "cluster" }}</code></td><td><strong>{{ f.title or f.check }}</strong></td></tr>
      {% endfor %}
      </tbody>
    </table>
    {% if r.eks_findings | length > 75 %}<p class="section-note">Showing 75 of {{ r.eks_findings | length }}; the full set is in HTML filtering and findings.json.</p>{% endif %}
  </section>
  {% endif %}

  <section id="scanners" class="keep">
    <h2>Tool execution evidence</h2>
    <table>
      <thead><tr><th style="width:23%">Scanner</th><th style="width:10%">Status</th><th style="width:10%">Records</th><th style="width:23%">Version</th><th>Notes</th></tr></thead>
      <tbody>
      {% for s in r.scanners %}
      <tr><td><strong>{{ s.name }}</strong></td><td><span class="tag status-{{ s.status }}">{{ s.status }}</span></td>
          <td>{{ s.findings }}</td><td>{{ s.version or "unavailable" }}</td><td class="plain">{{ s.message | plain_text }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

  <section class="screen-only" id="findings-section">
    <h2>Unified evidence register</h2>
    <p class="section-note">Defaults to failures. Passing evidence and informational observations remain in this same report.</p>
    <div class="controls">
      <input id="q" type="search" aria-label="Search findings" placeholder="Search resource, check, description…">
      <select id="fsev" aria-label="Filter severity"><option value="">All severities</option>{% for sev in severity_order %}<option value="{{ sev }}">{{ sev }}</option>{% endfor %}</select>
      <select id="ftool" aria-label="Filter tool"><option value="">All tools</option>{% for tool in r.findings | map(attribute="tool") | unique | sort %}<option value="{{ tool }}">{{ tool }}</option>{% endfor %}</select>
      <select id="fstatus" aria-label="Filter status"><option value="">All statuses</option><option value="fail" selected>Failures</option><option value="pass">Pass evidence</option><option value="info">Observations</option></select>
      <span class="visible-count" id="visible-count"></span>
    </div>
    <div class="wide-table">
      <table id="findings">
        <thead><tr><th style="width:10%">Severity</th><th style="width:12%">Tool</th><th style="width:15%">Service</th><th style="width:25%">Resource</th><th>Finding</th></tr></thead>
        <tbody>
        {% for f in r.findings %}
        <tr class="frow" data-sev="{{ f.severity.label }}" data-tool="{{ f.tool }}" data-status="{{ f.status }}">
          <td><span class="sev" style="background:{{ severity_colors[f.severity.label] }}">{{ f.severity.label }}</span></td>
          <td>{{ f.tool }}</td>
          <td>{{ f.service or "—" }}{% if f.region %}<br><span class="tag">{{ f.region }}</span>{% endif %}</td>
          <td><code>{{ f.resource or "n/a" }}</code></td>
          <td>
            <strong>{{ f.title or f.check }}</strong> <span class="tag status-{{ f.status }}">{{ f.status }}</span>
            {% if r.is_rollup and f.account_id %}<span class="tag">acct {{ f.account_id }}</span>{% endif %}
            {% for c in f.compliance_refs[:4] %}{% if not c.startswith("flagged-by") %}<span class="tag">{{ c }}</span>{% endif %}{% endfor %}
            {% if f.compliance_refs | length > 4 %}<span class="tag">+{{ f.compliance_refs | length - 4 }} controls</span>{% endif %}
            <details><summary>Evidence and remediation</summary>
              {% if f.description %}<p class="plain">{{ f.description | plain_text }}</p>{% endif %}
              {% if f.remediation %}<p class="remediation plain">Remediation: {{ f.remediation | plain_text }}</p>{% endif %}
              <p><span class="tag">id {{ f.id }}</span> <span class="tag">check {{ f.check }}</span></p>
            </details>
          </td>
        </tr>
        {% else %}
        <tr><td colspan="5" class="empty">{% if r.has_incomplete_scanners %}No normalized evidence because the scan was incomplete.{% else %}No findings.{% endif %}</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </section>

  <section class="print-only" id="failure-register">
    <h2>Failure register</h2>
    <p class="section-note">
      Compact register of the highest-ranked {{ [r.failed_total,150] | min }} failing findings.
      {% if r.failed_total > 150 %}The remaining {{ r.failed_total - 150 }} failures and all pass evidence are retained in report.html and findings.json.{% endif %}
    </p>
    <table class="register">
      <colgroup><col><col><col><col></colgroup>
      <thead><tr><th>Severity</th><th>Tool</th><th>Resource</th><th>Finding</th></tr></thead>
      <tbody>
      {% for f in r.failing_findings[:150] %}
      <tr><td><span class="sev" style="background:{{ severity_colors[f.severity.label] }}">{{ f.severity.label }}</span></td>
          <td>{{ f.tool }}</td><td><code>{{ f.resource or "n/a" }}</code></td>
          <td><strong>{{ f.title or f.check }}</strong>{% if f.account_id %}<br><span class="tag">acct {{ f.account_id }}</span>{% endif %}</td></tr>
      {% else %}<tr><td colspan="4" class="empty">No failing findings.</td></tr>{% endfor %}
      </tbody>
    </table>
  </section>
</main>

<footer>This report was generated by <a href="https://github.com/d2k-klin/sentryhive">OSS SentryHive</a> by Mr. D · consolidated evidence, one engagement report</footer>
<script>
  const q = document.getElementById("q");
  const fsev = document.getElementById("fsev");
  const ftool = document.getElementById("ftool");
  const fstatus = document.getElementById("fstatus");
  const visible = document.getElementById("visible-count");
  const rows = Array.from(document.querySelectorAll(".frow"));
  function applyFilters() {
    const text = q.value.trim().toLowerCase();
    let shown = 0;
    rows.forEach(row => {
      const ok = (!text || row.textContent.toLowerCase().includes(text))
        && (!fsev.value || row.dataset.sev === fsev.value)
        && (!ftool.value || row.dataset.tool === ftool.value)
        && (!fstatus.value || row.dataset.status === fstatus.value);
      row.hidden = !ok;
      if (ok) shown += 1;
    });
    visible.textContent = `${shown} of ${rows.length}`;
  }
  [q,fsev,ftool,fstatus].forEach(element => element.addEventListener("input",applyFilters));
  applyFilters();
</script>
</body>
</html>
